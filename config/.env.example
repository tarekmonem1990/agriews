# AgriEWS — environment configuration
# Copy this file to config/.env and fill in your values
# Never share your .env file — it contains your secret keys

# ── Core ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agriews:agriews@localhost:5432/agriews
REDIS_URL=redis://localhost:6379/0

# ── Anthropic (advisory generation) ───────────────────
# Get your key at console.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=400

# ── Weather (free, no key needed) ─────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ── Market prices (free, no key needed) ───────────────
WFP_VAM_BASE_URL=https://api.vam.wfp.org/

# ── SMS — Africa's Talking ────────────────────────────
# Get your key at africastalking.com (free sandbox)
AT_API_KEY=paste-your-key-here
AT_USERNAME=sandbox
AT_SENDER_ID=AgriEWS

# ── WhatsApp — Meta Cloud API ─────────────────────────
# Get at developers.facebook.com
WHATSAPP_API_TOKEN=paste-your-token-here
WHATSAPP_PHONE_NUMBER_ID=paste-your-phone-number-id-here
WHATSAPP_VERIFY_TOKEN=agriews-verify

# ── Pipeline schedules (cron format) ──────────────────
# These control when each job runs automatically
WEATHER_INGEST_CRON=0 */3 * * *
MARKET_INGEST_CRON=0 6 * * *
SHOCK_MONITOR_CRON=0 */6 * * *
ADVISORY_GENERATION_CRON=0 5 * * *
DELIVERY_CRON=0 6 * * *
# ACLED conflict events (free — register at acleddata.com)
ACLED_API_KEY=paste-your-key-here
ACLED_EMAIL=your-email@example.com
